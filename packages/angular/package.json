{
  "name": "@accelerate/angular",
  "version": "0.1.8",
  "description": "Accelerate — Angular bindings for Accelerate.",
  "keywords": [
    "accelerate",
    "typescript",
    "angular"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./authentication": {
      "types": "./dist/modules/authentication-angular/dist/index.d.ts",
      "default": "./dist/modules/authentication-angular/dist/index.js"
    },
    "./authorization": {
      "types": "./dist/modules/authorization-angular/index.d.ts",
      "default": "./dist/modules/authorization-angular/fesm2022/accelerate-authorization-angular.mjs"
    },
    "./config": {
      "types": "./dist/modules/config-angular/dist/index.d.ts",
      "default": "./dist/modules/config-angular/dist/index.js"
    },
    "./forms": {
      "types": "./dist/modules/forms-angular/dist/index.d.ts",
      "default": "./dist/modules/forms-angular/dist/index.js"
    },
    "./http": {
      "types": "./dist/modules/http-angular/dist/index.d.ts",
      "default": "./dist/modules/http-angular/dist/index.js"
    },
    "./logging": {
      "types": "./dist/modules/logging-angular/index.d.ts",
      "default": "./dist/modules/logging-angular/fesm2022/accelerate-logging-angular.mjs"
    },
    "./state": {
      "types": "./dist/modules/state-angular/dist/index.d.ts",
      "default": "./dist/modules/state-angular/dist/index.js"
    },
    "./tables": {
      "types": "./dist/modules/tables-angular/dist/index.d.ts",
      "default": "./dist/modules/tables-angular/dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../tools/registry/consolidation.mjs build angular",
    "typecheck": "tsc --noEmit --skipLibCheck --module NodeNext --moduleResolution NodeNext dist/index.d.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/archubbuck/accelerate.git",
    "directory": "packages/angular"
  },
  "homepage": "https://github.com/archubbuck/accelerate/blob/main/packages/angular/README.md",
  "bugs": "https://github.com/archubbuck/accelerate/issues",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  },
  "dependencies": {
    "@accelerate/identity": "0.5.2",
    "tslib": "^2.6.2",
    "@accelerate/config": "0.1.0",
    "@accelerate/ui": "0.1.0",
    "@accelerate/http": "0.3.2",
    "@accelerate/observability": "0.1.0"
  },
  "devDependencies": {
    "@accelerate/authentication-angular": "0.1.0",
    "@accelerate/authorization-angular": "0.1.3",
    "@accelerate/config-angular": "0.1.0",
    "@accelerate/forms-angular": "0.1.0",
    "@accelerate/http-angular": "0.1.0",
    "@accelerate/logging-angular": "0.1.1",
    "@accelerate/state-angular": "0.1.0",
    "@accelerate/tables-angular": "0.1.0"
  },
  "peerDependencies": {
    "@angular/core": ">=19 <21",
    "@angular/common": ">=19 <21",
    "rxjs": "^7.4.0"
  },
  "peerDependenciesMeta": {
    "@angular/core": {
      "optional": true
    },
    "@angular/common": {
      "optional": true
    },
    "rxjs": {
      "optional": true
    }
  }
}
