{
  "name": "@accelerate/tooling-patches",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit --strict --skipLibCheck --module nodenext --moduleResolution nodenext src/index.d.mts",
    "test": "node --test ../../tools/registry/operation-patches.test.mjs ../../tools/registry/operation-apply.test.mjs ../../tools/registry/operation-file-plans.test.mjs ../../tools/registry/operation-mixed-preflight.test.mjs ../../tools/registry/operation-mixed-apply.test.mjs ../../tools/registry/operation-journal.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/archubbuck/accelerate.git",
    "directory": "packages/tooling-patches"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
