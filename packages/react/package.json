{
  "name": "@accelerate/react",
  "version": "0.1.0-next.0",
  "description": "Accelerate — React bindings for Accelerate.",
  "keywords": [
    "accelerate",
    "typescript",
    "react"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./authentication": {
      "types": "./dist/modules/authentication-react/dist/index.d.ts",
      "default": "./dist/modules/authentication-react/dist/index.js"
    },
    "./authorization": {
      "types": "./dist/modules/authorization-react/dist/index.d.ts",
      "default": "./dist/modules/authorization-react/dist/index.js"
    },
    "./config": {
      "types": "./dist/modules/config-react/dist/index.d.ts",
      "default": "./dist/modules/config-react/dist/index.js"
    },
    "./forms": {
      "types": "./dist/modules/forms-react/dist/index.d.ts",
      "default": "./dist/modules/forms-react/dist/index.js"
    },
    "./http": {
      "types": "./dist/modules/http-react/dist/index.d.ts",
      "default": "./dist/modules/http-react/dist/index.js"
    },
    "./logging": {
      "types": "./dist/modules/logging-react/dist/index.d.ts",
      "default": "./dist/modules/logging-react/dist/index.js"
    },
    "./state": {
      "types": "./dist/modules/state-react/dist/index.d.ts",
      "default": "./dist/modules/state-react/dist/index.js"
    },
    "./tables": {
      "types": "./dist/modules/tables-react/dist/index.d.ts",
      "default": "./dist/modules/tables-react/dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../tools/registry/consolidation.mjs build react",
    "typecheck": "tsc --noEmit --skipLibCheck --module NodeNext --moduleResolution NodeNext dist/index.d.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/archubbuck/accelerate.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/archubbuck/accelerate/blob/main/packages/react/README.md",
  "bugs": "https://github.com/archubbuck/accelerate/issues",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "next"
  },
  "dependencies": {
    "@accelerate/identity": "0.1.0-next.0",
    "@accelerate/config": "0.1.0-next.0",
    "@accelerate/ui": "0.1.0-next.0",
    "@accelerate/http": "0.1.0-next.0",
    "@accelerate/observability": "0.1.0-next.0"
  },
  "devDependencies": {
    "@accelerate/authentication-react": "0.1.0",
    "@accelerate/authorization-react": "0.1.3",
    "@accelerate/config-react": "0.1.0",
    "@accelerate/forms-react": "0.1.0",
    "@accelerate/http-react": "0.1.0",
    "@accelerate/logging-react": "0.1.1",
    "@accelerate/state-react": "0.1.0",
    "@accelerate/tables-react": "0.1.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
