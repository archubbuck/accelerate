{
  "name": "@accelerate/data",
  "version": "0.6.0",
  "description": "Accelerate — Database adapters, transactions, caches, migrations and coordination.",
  "keywords": [
    "accelerate",
    "typescript",
    "data",
    "postgresql",
    "migrations",
    "cache"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./storage/s3": {
      "types": "./dist/features/storage-s3.d.ts",
      "default": "./dist/features/storage-s3.js"
    },
    "./cache": {
      "types": "./dist/modules/cache-core/dist/index.d.ts",
      "default": "./dist/modules/cache-core/dist/index.js"
    },
    "./cache/memory": {
      "types": "./dist/modules/cache-memory/dist/index.d.ts",
      "default": "./dist/modules/cache-memory/dist/index.js"
    },
    "./cache/redis": {
      "types": "./dist/modules/cache-redis/dist/index.d.ts",
      "default": "./dist/modules/cache-redis/dist/index.js"
    },
    "./core": {
      "types": "./dist/modules/data-core/dist/index.d.ts",
      "default": "./dist/modules/data-core/dist/index.js"
    },
    "./provenance": {
      "types": "./dist/modules/data-core/dist/provenance.d.ts",
      "default": "./dist/modules/data-core/dist/provenance.js"
    },
    "./ledger": {
      "types": "./dist/modules/data-core/dist/ledger.d.ts",
      "default": "./dist/modules/data-core/dist/ledger.js"
    },
    "./ledger/memory": {
      "types": "./dist/modules/data-core/dist/ledger-memory.d.ts",
      "default": "./dist/modules/data-core/dist/ledger-memory.js"
    },
    "./time-series": {
      "types": "./dist/modules/data-core/dist/time-series.d.ts",
      "default": "./dist/modules/data-core/dist/time-series.js"
    },
    "./experiments": {
      "types": "./dist/modules/data-core/dist/experiments.d.ts",
      "default": "./dist/modules/data-core/dist/experiments.js"
    },
    "./storage": {
      "types": "./dist/modules/data-core/dist/storage.d.ts",
      "default": "./dist/modules/data-core/dist/storage.js"
    },
    "./storage/memory": {
      "types": "./dist/modules/data-core/dist/storage-memory.d.ts",
      "default": "./dist/modules/data-core/dist/storage-memory.js"
    },
    "./postgres": {
      "types": "./dist/modules/data-postgres/dist/index.d.ts",
      "default": "./dist/modules/data-postgres/dist/index.js"
    },
    "./provenance/postgres": {
      "types": "./dist/modules/data-postgres/dist/provenance.d.ts",
      "default": "./dist/modules/data-postgres/dist/provenance.js"
    },
    "./ledger/postgres": {
      "types": "./dist/modules/data-postgres/dist/ledger.d.ts",
      "default": "./dist/modules/data-postgres/dist/ledger.js"
    },
    "./time-series/postgres": {
      "types": "./dist/modules/data-postgres/dist/time-series.d.ts",
      "default": "./dist/modules/data-postgres/dist/time-series.js"
    },
    "./experiments/postgres": {
      "types": "./dist/modules/data-postgres/dist/experiments.d.ts",
      "default": "./dist/modules/data-postgres/dist/experiments.js"
    },
    "./prisma": {
      "types": "./dist/modules/data-prisma/dist/index.d.ts",
      "default": "./dist/modules/data-prisma/dist/index.js"
    },
    "./sqlserver": {
      "types": "./dist/modules/data-sqlserver/dist/index.d.ts",
      "default": "./dist/modules/data-sqlserver/dist/index.js"
    },
    "./idempotency": {
      "types": "./dist/modules/idempotency-core/dist/index.d.ts",
      "default": "./dist/modules/idempotency-core/dist/index.js"
    },
    "./idempotency/memory": {
      "types": "./dist/modules/idempotency-memory/dist/index.d.ts",
      "default": "./dist/modules/idempotency-memory/dist/index.js"
    },
    "./idempotency/postgres": {
      "types": "./dist/modules/idempotency-postgres/dist/index.d.ts",
      "default": "./dist/modules/idempotency-postgres/dist/index.js"
    },
    "./locking": {
      "types": "./dist/modules/locking-core/dist/index.d.ts",
      "default": "./dist/modules/locking-core/dist/index.js"
    },
    "./locking/memory": {
      "types": "./dist/modules/locking-memory/dist/index.d.ts",
      "default": "./dist/modules/locking-memory/dist/index.js"
    },
    "./locking/postgres": {
      "types": "./dist/modules/locking-postgres/dist/index.d.ts",
      "default": "./dist/modules/locking-postgres/dist/index.js"
    },
    "./migrations": {
      "types": "./dist/modules/migrations-core/dist/index.d.ts",
      "default": "./dist/modules/migrations-core/dist/index.js"
    },
    "./migrations/postgres": {
      "types": "./dist/modules/migrations-postgres/dist/index.d.ts",
      "default": "./dist/modules/migrations-postgres/dist/index.js"
    },
    "./transactions": {
      "types": "./dist/modules/transactions/dist/index.d.ts",
      "default": "./dist/modules/transactions/dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../tools/registry/consolidation.mjs build data",
    "typecheck": "tsc --noEmit --skipLibCheck --module NodeNext --moduleResolution NodeNext dist/index.d.ts",
    "test": "vitest run src"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/archubbuck/accelerate.git",
    "directory": "packages/data"
  },
  "homepage": "https://github.com/archubbuck/accelerate/blob/main/packages/data/README.md",
  "bugs": "https://github.com/archubbuck/accelerate/issues",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  },
  "accelerate": {
    "operations": "./dist/operations/package-manifest.json"
  },
  "dependencies": {
    "@accelerate/core": "0.2.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "@types/node": "^22.0.0",
    "@accelerate/cache-core": "0.1.0",
    "@accelerate/cache-memory": "0.1.0",
    "@accelerate/cache-redis": "0.1.0",
    "@accelerate/data-core": "0.1.1",
    "@accelerate/data-postgres": "0.1.2",
    "@accelerate/data-prisma": "0.1.1",
    "@accelerate/data-sqlserver": "0.1.1",
    "@accelerate/idempotency-core": "0.1.0",
    "@accelerate/idempotency-memory": "0.1.0",
    "@accelerate/idempotency-postgres": "0.1.1",
    "@accelerate/locking-core": "0.1.0",
    "@accelerate/locking-memory": "0.1.0",
    "@accelerate/locking-postgres": "0.1.1",
    "@accelerate/migrations-core": "0.1.0",
    "@accelerate/migrations-postgres": "0.1.1",
    "@accelerate/transactions": "0.1.1"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "pg": "^8.11.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@aws-sdk/s3-request-presigner": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  }
}
