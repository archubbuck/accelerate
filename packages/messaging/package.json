{
  "name": "@accelerate/messaging",
  "version": "0.1.0",
  "description": "Accelerate — Events, jobs, workflows, scheduling and transactional outbox.",
  "keywords": [
    "accelerate",
    "typescript",
    "messaging",
    "events",
    "jobs",
    "workflows"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./events": {
      "types": "./dist/modules/events-core/dist/index.d.ts",
      "default": "./dist/modules/events-core/dist/index.js"
    },
    "./events/memory": {
      "types": "./dist/modules/events-memory/dist/index.d.ts",
      "default": "./dist/modules/events-memory/dist/index.js"
    },
    "./events/postgres": {
      "types": "./dist/modules/events-postgres/dist/index.d.ts",
      "default": "./dist/modules/events-postgres/dist/index.js"
    },
    "./events/redis": {
      "types": "./dist/modules/events-redis/dist/index.d.ts",
      "default": "./dist/modules/events-redis/dist/index.js"
    },
    "./jobs": {
      "types": "./dist/modules/jobs-core/dist/index.d.ts",
      "default": "./dist/modules/jobs-core/dist/index.js"
    },
    "./jobs/postgres": {
      "types": "./dist/modules/jobs-postgres/dist/index.d.ts",
      "default": "./dist/modules/jobs-postgres/dist/index.js"
    },
    "./jobs/postgres/testing": {
      "types": "./dist/modules/jobs-postgres/dist/testing.d.ts",
      "default": "./dist/modules/jobs-postgres/dist/testing.js"
    },
    "./outbox": {
      "types": "./dist/modules/outbox-core/dist/index.d.ts",
      "default": "./dist/modules/outbox-core/dist/index.js"
    },
    "./outbox/postgres": {
      "types": "./dist/modules/outbox-postgres/dist/index.d.ts",
      "default": "./dist/modules/outbox-postgres/dist/index.js"
    },
    "./scheduler": {
      "types": "./dist/modules/scheduler-core/dist/index.d.ts",
      "default": "./dist/modules/scheduler-core/dist/index.js"
    },
    "./scheduler/postgres": {
      "types": "./dist/modules/scheduler-postgres/dist/index.d.ts",
      "default": "./dist/modules/scheduler-postgres/dist/index.js"
    },
    "./workflows": {
      "types": "./dist/modules/workflows-core/dist/index.d.ts",
      "default": "./dist/modules/workflows-core/dist/index.js"
    },
    "./workflows/memory": {
      "types": "./dist/modules/workflows-memory/dist/index.d.ts",
      "default": "./dist/modules/workflows-memory/dist/index.js"
    },
    "./workflows/postgres": {
      "types": "./dist/modules/workflows-postgres/dist/index.d.ts",
      "default": "./dist/modules/workflows-postgres/dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../tools/registry/consolidation.mjs build messaging",
    "typecheck": "tsc --noEmit --skipLibCheck --module NodeNext --moduleResolution NodeNext dist/index.d.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/archubbuck/accelerate.git",
    "directory": "packages/messaging"
  },
  "homepage": "https://github.com/archubbuck/accelerate/blob/main/packages/messaging/README.md",
  "bugs": "https://github.com/archubbuck/accelerate/issues",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  },
  "dependencies": {
    "@accelerate/data": "0.1.0",
    "cronosjs": "1.7.1",
    "@js-temporal/polyfill": "^0.5.1"
  },
  "devDependencies": {
    "@accelerate/events-core": "0.1.1",
    "@accelerate/events-memory": "0.1.1",
    "@accelerate/events-postgres": "0.1.2",
    "@accelerate/events-redis": "0.1.1",
    "@accelerate/jobs-core": "0.1.0",
    "@accelerate/jobs-postgres": "0.1.1",
    "@accelerate/outbox-core": "0.1.1",
    "@accelerate/outbox-postgres": "0.1.1",
    "@accelerate/scheduler-core": "0.2.0",
    "@accelerate/scheduler-postgres": "0.1.0",
    "@accelerate/workflows-core": "0.1.2",
    "@accelerate/workflows-memory": "0.1.0",
    "@accelerate/workflows-postgres": "0.1.0"
  }
}
