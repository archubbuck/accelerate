{
  "name": "@accelerate/identity",
  "version": "0.5.3",
  "description": "Accelerate — Authentication, authorization, API keys and auditing.",
  "keywords": [
    "accelerate",
    "typescript",
    "identity",
    "authentication",
    "authorization",
    "audit"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./api-keys": {
      "types": "./dist/modules/api-keys/dist/index.d.ts",
      "default": "./dist/modules/api-keys/dist/index.js"
    },
    "./api-keys/service": {
      "types": "./dist/modules/api-keys/dist/service.d.ts",
      "default": "./dist/modules/api-keys/dist/service.js"
    },
    "./api-keys/postgres": {
      "types": "./dist/modules/api-keys/dist/postgres.d.ts",
      "default": "./dist/modules/api-keys/dist/postgres.js"
    },
    "./audit": {
      "types": "./dist/modules/audit-core/dist/index.d.ts",
      "default": "./dist/modules/audit-core/dist/index.js"
    },
    "./audit/integrity": {
      "types": "./dist/modules/audit-core/dist/integrity.d.ts",
      "default": "./dist/modules/audit-core/dist/integrity.js"
    },
    "./audit/postgres": {
      "types": "./dist/modules/audit-postgres/dist/index.d.ts",
      "default": "./dist/modules/audit-postgres/dist/index.js"
    },
    "./audit/postgres/integrity": {
      "types": "./dist/modules/audit-postgres/dist/integrity.d.ts",
      "default": "./dist/modules/audit-postgres/dist/integrity.js"
    },
    "./authentication": {
      "types": "./dist/modules/authentication-core/dist/index.d.ts",
      "default": "./dist/modules/authentication-core/dist/index.js"
    },
    "./authentication/oauth": {
      "types": "./dist/modules/authentication-core/dist/external/oauth.d.ts",
      "default": "./dist/modules/authentication-core/dist/external/oauth.js"
    },
    "./authentication/oidc": {
      "types": "./dist/modules/authentication-core/dist/external/oidc.d.ts",
      "default": "./dist/modules/authentication-core/dist/external/oidc.js"
    },
    "./authentication/node": {
      "types": "./dist/modules/authentication-node/dist/index.d.ts",
      "default": "./dist/modules/authentication-node/dist/index.js"
    },
    "./authentication/postgres": {
      "types": "./dist/modules/authentication-postgres/dist/index.d.ts",
      "default": "./dist/modules/authentication-postgres/dist/index.js"
    },
    "./authentication/postgres/external": {
      "types": "./dist/modules/authentication-postgres/dist/external.d.ts",
      "default": "./dist/modules/authentication-postgres/dist/external.js"
    },
    "./authorization": {
      "types": "./dist/modules/authorization-core/dist/index.d.ts",
      "default": "./dist/modules/authorization-core/dist/index.js"
    },
    "./authorization/scoped": {
      "types": "./dist/modules/authorization-core/dist/scoped.d.ts",
      "default": "./dist/modules/authorization-core/dist/scoped.js"
    },
    "./authorization/postgres": {
      "types": "./dist/modules/authorization-postgres/dist/index.d.ts",
      "default": "./dist/modules/authorization-postgres/dist/index.js"
    },
    "./authorization/postgres/admin": {
      "types": "./dist/modules/authorization-postgres/dist/admin.d.ts",
      "default": "./dist/modules/authorization-postgres/dist/admin.js"
    },
    "./authorization/postgres/scoped": {
      "types": "./dist/modules/authorization-postgres/dist/scoped.d.ts",
      "default": "./dist/modules/authorization-postgres/dist/scoped.js"
    },
    "./security": {
      "types": "./dist/modules/security-core/dist/index.d.ts",
      "default": "./dist/modules/security-core/dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../tools/registry/consolidation.mjs build identity",
    "typecheck": "tsc --noEmit --skipLibCheck --module NodeNext --moduleResolution NodeNext dist/index.d.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/archubbuck/accelerate.git",
    "directory": "packages/identity"
  },
  "homepage": "https://github.com/archubbuck/accelerate/blob/main/packages/identity/README.md",
  "bugs": "https://github.com/archubbuck/accelerate/issues",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  },
  "dependencies": {
    "@accelerate/data": "0.3.1"
  },
  "devDependencies": {
    "@accelerate/api-keys": "0.1.0",
    "@accelerate/audit-core": "0.1.0",
    "@accelerate/audit-postgres": "0.1.0",
    "@accelerate/authentication-core": "0.1.0",
    "@accelerate/authentication-node": "0.1.0",
    "@accelerate/authentication-postgres": "0.1.0",
    "@accelerate/authorization-core": "0.1.3",
    "@accelerate/authorization-postgres": "0.1.3",
    "@accelerate/security-core": "0.1.0"
  },
  "peerDependencies": {
    "openid-client": "^6.9.1",
    "pg": "^8.11.0"
  },
  "peerDependenciesMeta": {
    "openid-client": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  }
}
