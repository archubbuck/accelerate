{
  "name": "@accelerate/authorization-postgres",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./admin": {
      "types": "./dist/admin.d.ts",
      "default": "./dist/admin.js"
    }
  },
  "files": [
    "dist",
    "schema.sql",
    "admin.sql"
  ],
  "peerDependencies": {
    "@accelerate/authorization-core": "^0.1.0",
