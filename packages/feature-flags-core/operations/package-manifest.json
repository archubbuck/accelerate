{
  "schemaVersion": "1.0",
  "package": "@accelerate/feature-flags-core",
  "packageVersion": "0.1.0",
  "operations": [
    {
      "manifest": {
        "id": "feature-flags.evaluate",
        "version": "1.0.0",
        "package": "@accelerate/feature-flags-core",
        "description": "Evaluate an explicit flag definition against supplied context without runtime access",
        "mutatesProject": false,
        "modes": [
          "inspect",
          "preview"
        ],
        "inputSchema": {
          "type": "object",
          "required": [
            "flag"
          ],
          "additionalProperties": false,
          "properties": {
            "flag": {
              "type": "object",
              "required": [
                "key",
                "enabled"
              ],
              "additionalProperties": false,
              "properties": {
                "key": {
                  "type": "string"
                },
                "enabled": {
                  "type": "boolean"
                },
                "rules": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "attribute",
                      "equals",
                      "enabled"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "attribute": {
                        "type": "string"
                      },
                      "equals": {
                        "type": "string"
                      },
                      "enabled": {
                        "type": "boolean"
                      }
                    }
                  }
                }
              }
            },
            "context": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "subject": {
                  "type": "string"
                },
                "attributes": {
                  "type": "object"
                }
              }
            }
          }
        },
        "outputSchema": {
          "type": "object",
          "required": [
            "enabled",
            "runtimeWiringVerified"
          ],
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "runtimeWiringVerified": {
              "const": false
            }
          }
        }
      },
      "handler": "./dist/operations/evaluate.mjs",
      "exportName": "evaluate"
    },
    {
      "manifest": {
        "id": "feature-flags.list",
        "version": "1.0.0",
        "package": "@accelerate/feature-flags-core",
        "description": "Inspect explicit JSON flag registry",
        "mutatesProject": false,
        "modes": [
          "inspect",
          "preview"
        ],
        "inputSchema": {
          "type": "object",
          "required": [
            "target"
          ],
          "additionalProperties": false,
          "properties": {
            "target": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "outputSchema": {
          "type": "object"
        }
      },
      "handler": "./dist/operations/inspect.mjs",
      "exportName": "list"
    },
    {
      "manifest": {
        "id": "feature-flags.describe",
        "version": "1.0.0",
        "package": "@accelerate/feature-flags-core",
        "description": "Describe an existing flag definition",
        "mutatesProject": false,
        "modes": [
          "inspect",
          "preview"
        ],
        "inputSchema": {
          "type": "object",
          "required": [
            "target",
            "key"
          ],
          "additionalProperties": false,
          "properties": {
            "target": {
              "type": "string",
              "minLength": 1
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "outputSchema": {
          "type": "object"
        }
      },
      "handler": "./dist/operations/inspect.mjs",
      "exportName": "describe"
    },
    {
      "manifest": {
        "id": "feature-flags.validate",
        "version": "1.0.0",
        "package": "@accelerate/feature-flags-core",
        "description": "Validate explicit JSON flag definitions",
        "mutatesProject": false,
        "modes": [
          "inspect",
          "preview",
          "verify"
        ],
        "inputSchema": {
          "type": "object",
          "required": [
            "target"
          ],
          "additionalProperties": false,
          "properties": {
            "target": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "outputSchema": {
          "type": "object"
        }
      },
      "handler": "./dist/operations/inspect.mjs",
      "exportName": "validate"
    },
    {
      "manifest": {
        "id": "feature-flags.find-usages",
        "version": "1.0.0",
        "package": "@accelerate/feature-flags-core",
        "description": "Find candidate usages flags within explicit source scope",
        "mutatesProject": false,
        "modes": [
          "inspect",
          "preview"
        ],
        "inputSchema": {
          "type": "object",
          "required": [
            "files",
            "receivers"
          ],
          "additionalProperties": false,
          "properties": {
            "files": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "receivers": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "outputSchema": {
          "type": "object"
        }
      },
      "handler": "./dist/operations/analyze.mjs",
      "exportName": "findUsages"
    },
    {
      "manifest": {
        "id": "feature-flags.find-unused",
        "version": "1.0.0",
        "package": "@accelerate/feature-flags-core",
        "description": "Find candidate unused flags within explicit source scope",
        "mutatesProject": false,
        "modes": [
          "inspect",
          "preview"
        ],
        "inputSchema": {
          "type": "object",
          "required": [
            "target",
            "files",
            "receivers"
          ],
          "additionalProperties": false,
          "properties": {
            "target": {
              "type": "string",
              "minLength": 1
            },
            "files": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "receivers": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "outputSchema": {
          "type": "object"
        }
      },
      "handler": "./dist/operations/analyze.mjs",
      "exportName": "findUnused"
    },
    {
      "manifest": {
        "id": "feature-flags.find-unregistered",
        "version": "1.0.0",
        "package": "@accelerate/feature-flags-core",
        "description": "Find candidate unregistered flags within explicit source scope",
        "mutatesProject": false,
        "modes": [
          "inspect",
          "preview"
        ],
        "inputSchema": {
          "type": "object",
          "required": [
            "target",
            "files",
            "receivers"
          ],
          "additionalProperties": false,
          "properties": {
            "target": {
              "type": "string",
              "minLength": 1
            },
            "files": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "receivers": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "outputSchema": {
          "type": "object"
        }
      },
      "handler": "./dist/operations/analyze.mjs",
      "exportName": "findUnregistered"
    }
  ]
}
