{
  "name": "@accelerate/feature-flags-core",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "operations/package-manifest.json"
  ],
  "scripts": {
    "build": "node ../../tools/operations/sync-manifest.mjs --check && tsc -p tsconfig.json && node ../../tools/operations/bundle.mjs operations/evaluate.mjs dist/operations/evaluate.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "operations:sync": "node ../../tools/operations/sync-manifest.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/archubbuck/accelerate.git",
    "directory": "packages/feature-flags-core"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "accelerate": {
    "operations": "./operations/package-manifest.json"
  }
}
