{
  "name": "@accelerate/testing",
  "version": "0.1.7",
  "description": "Accelerate — Fixtures, transport helpers, contract and architecture tests.",
  "keywords": [
    "accelerate",
    "typescript",
    "testing"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./architecture": {
      "types": "./dist/modules/testing-architecture/dist/index.d.ts",
      "default": "./dist/modules/testing-architecture/dist/index.js"
    },
    "./contracts": {
      "types": "./dist/modules/testing-contracts/dist/index.d.ts",
      "default": "./dist/modules/testing-contracts/dist/index.js"
    },
    "./core": {
      "types": "./dist/modules/testing-core/dist/index.d.ts",
      "default": "./dist/modules/testing-core/dist/index.js"
    },
    "./fixtures": {
      "types": "./dist/modules/testing-fixtures/dist/index.d.ts",
      "default": "./dist/modules/testing-fixtures/dist/index.js"
    },
    "./http": {
      "types": "./dist/modules/testing-http/dist/index.d.ts",
      "default": "./dist/modules/testing-http/dist/index.js"
    },
    "./postgres": {
      "types": "./dist/modules/testing-postgres/dist/index.d.ts",
      "default": "./dist/modules/testing-postgres/dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../tools/registry/consolidation.mjs build testing",
    "typecheck": "tsc --noEmit --skipLibCheck --module NodeNext --moduleResolution NodeNext dist/index.d.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/archubbuck/accelerate.git",
    "directory": "packages/testing"
  },
  "homepage": "https://github.com/archubbuck/accelerate/blob/main/packages/testing/README.md",
  "bugs": "https://github.com/archubbuck/accelerate/issues",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  },
  "dependencies": {
    "@accelerate/http": "0.3.5"
  },
  "devDependencies": {
    "@accelerate/testing-architecture": "0.1.0",
    "@accelerate/testing-contracts": "0.1.0",
    "@accelerate/testing-core": "0.1.0",
    "@accelerate/testing-fixtures": "0.1.0",
    "@accelerate/testing-http": "0.1.0",
    "@accelerate/testing-postgres": "0.1.0"
  }
}
